{
  "outputStyle": "Partner In Crime",
  "permissions": {
    "allow": [
      "Bash(node .claude/scripts/ang-context-manager.mjs:*)",
      "Bash(echo:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/ang-context-manager.mjs\" session banner"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/ang-context-manager.mjs\" session subagent"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/ang-context-manager.mjs\" library index --quiet"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo fixture"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/ang-context-manager.mjs\" library index --quiet"
          }
        ]
      }
    ]
  },
  "env": {
    "FIXTURE_FLAVOUR": "eligendi"
  }
}
